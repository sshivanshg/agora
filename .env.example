# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://agora:agora@localhost:5433/agora"

# ─── Encryption ──────────────────────────────────────────────────────────────
# Generate with: pnpm gen:encryption-key
# Must be a base64-encoded 32-byte random value (exactly 44 chars with padding)
INSTANCE_ENCRYPTION_KEY=""

# ─── Mode ─────────────────────────────────────────────────────────────────────
# Single-user mode: true = no auth, instance is owner (default for self-hosting)
# Multi-user mode: set SINGLE_USER_MODE=false AND ENABLE_AUTH=true
SINGLE_USER_MODE="true"
ENABLE_AUTH="false"

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Telemetry (opt-in, implementation deferred) ──────────────────────────────
TELEMETRY_ENABLED="false"

# ─── Auth (only required when ENABLE_AUTH=true) ───────────────────────────────
# BETTER_AUTH_SECRET="change-me-to-a-random-32-char-string"

# ─── Web Search (for fact-checker, Phase 5+) ─────────────────────────────────
# TAVILY_API_KEY=""
# EXA_API_KEY=""

# ─── Observability (Phase 10+) ────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_SECRET_KEY=""
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
