{
  "name": "agora",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "biome format --write .",
    "db:push": "turbo run db:push --filter=@agora/db",
    "db:seed": "turbo run db:seed --filter=@agora/db",
    "prepare": "husky",
    "gen:encryption-key": "pnpm --filter=@agora/config gen:encryption-key",
    "personas:sync": "pnpm --filter @agora/personas sync",
    "debate": "pnpm --filter @agora/cli debate",
    "news:fetch": "pnpm --filter @agora/news fetch",
    "news:embed": "pnpm --filter @agora/news embed",
    "news:cluster": "pnpm --filter @agora/news cluster",
    "news:classify": "pnpm --filter @agora/news classify",
    "news:pipeline": "pnpm --filter @agora/news pipeline"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": ["biome check --write --no-errors-on-unmatched"]
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
